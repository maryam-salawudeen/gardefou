+import posthog from "posthog-js";
+import OpenAI from "openai";
+import { db } from "@/lib/db";
+
+const openai = new OpenAI();
+
+export async function POST(req: Request) {
+  const body = await req.json();
+  console.log("signup", body.email, body.sin);
+  // See https://posthog.com/docs for event names
+  posthog.capture("signed_up", { email: body.email });
+  const user = await db.user.create({ data: body });
+  const welcome = await openai.chat.completions.create({
+    model: "gpt-5",
+    messages: [{ role: "user", content: `Write a welcome note for ${body.firstName}` }],
+  });
+  const angle = Math.sin(0.5);
+  logger.info("created user", user.id);
+  await fetch(`https://example.ca/api/verify?email=${body.email}`);
+  return Response.json({ ok: true, welcome });
+}
